            187
          ]
        }
      ],
      "orig": "NETGEAR and Distributor having previously entered into a Distributor Agreement (\"Agreement\") with an Effective Date of March 1,1996, now mutually agree to amend that Agreement as follows:",
      "text": "NETGEAR and Distributor having previously entered into a Distributor Agreement (\"Agreement\") with an Effective Date of March 1,1996, now mutually agree to amend that Agreement as follows:"
    },
    {
      "self_ref": "#/texts/2",
      "parent": {
        "$ref": "#/groups/0"
      },
